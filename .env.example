# Copy this file to .env.local and fill in the two values from Supabase.
# In the Supabase dashboard: Project Settings -> API.
#
# .env.local is listed in .gitignore and must never be committed.
# On Vercel, add the same two variables under Settings -> Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
